# MK GitFlow — environment variables
# Copy to `.env.local` and fill in as needed. Everything here is OPTIONAL:
# the app builds and every deterministic tool works with none of these set.
# Never commit real values — only this template is tracked (STANDARDS §2 / §8).

# ---------------------------------------------------------------------------
# Site
# ---------------------------------------------------------------------------
# Canonical origin used for metadata, sitemap, and Open Graph URLs.
# Defaults to the production domain when unset.
NEXT_PUBLIC_SITE_URL=https://gitflow.mkazi.live

# ---------------------------------------------------------------------------
# AI layer (STANDARDS §10) — OPTIONAL
# ---------------------------------------------------------------------------
# The AI assistant (/assistant, POST /api/ai/*) calls models through the Vercel
# AI Gateway using gateway model strings. With NO credentials set, AI requests
# return an honest "unavailable" response and the UI falls back to deterministic,
# clearly-labeled local results where one exists.
#
# Server credential (choose ONE):
#   - AI_GATEWAY_API_KEY: a Vercel AI Gateway key for local dev / self-hosting.
#   - Vercel OIDC: on Vercel deployments the gateway authenticates automatically
#     via the injected VERCEL_OIDC_TOKEN — no key needed. Do not set it yourself.
AI_GATEWAY_API_KEY=

# Model selection (gateway model strings). Changing the model is a config change,
# never a code change. Defaults are used when unset.
#   Fast tier    (nl-to-command, commit-from-diff)
AI_MODEL=anthropic/claude-haiku-4.5
#   Quality tier (explanations, planning, PR/release drafting)
AI_MODEL_QUALITY=anthropic/claude-sonnet-4-5

# Note on BYOK: users may instead supply their own gateway key in the browser.
# It is sent per request in the `x-byok-key` header and is NEVER read from the
# environment, stored, or logged. There is no server env var for it by design.

# ---------------------------------------------------------------------------
# Analytics (STANDARDS §6) — OPTIONAL, consent-gated
# ---------------------------------------------------------------------------
# Google Tag Manager container id. Unset => analytics fully disabled (no script).
# Even when set, GTM only loads in production AND after explicit user consent.
NEXT_PUBLIC_GTM_ID=

# ---------------------------------------------------------------------------
# AdSense (STANDARDS §7) — OPTIONAL, disabled by default
# ---------------------------------------------------------------------------
# Reserved for future use. No ad script loads unless this is explicitly "true".
NEXT_PUBLIC_ADSENSE_ENABLED=false
